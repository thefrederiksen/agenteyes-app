<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 10.0.19041.0 enables the Windows.Graphics.Capture WinRT projection used by the
         Phase 3 video engine. WinForms + WPF are both on for monitor enumeration,
         screenshots, the region overlay, and the (future) HUD. -->
    <!-- Issue #102: the engine also builds for Linux (net8.0): x11grab/pulse/v4l2 capture, XDG
         paths, a headless Control API (agenteyes serve) and a systemd user service. The Windows
         target is unchanged and is the only one the App and the tests consume. The Windows target
         needs the WindowsDesktop SDK, which a Linux SDK does not ship, so off Windows only net8.0 is
         built (EnableWindowsTargeting=true brings the Windows target back for an SDK that has it). -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' Or '$(EnableWindowsTargeting)' == 'true'">net8.0-windows10.0.19041.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT' And '$(EnableWindowsTargeting)' != 'true'">net8.0</TargetFrameworks>
    <RootNamespace>AgentEyes</RootNamespace>
    <!-- The CLI ships as agenteyes.exe (short to type; a bare shadow.exe would collide with the
         Windows RDP "shadow" concept). The WPF app owns the AgentEyesApp.exe name. -->
    <AssemblyName>agenteyes</AssemblyName>
    <Version>1.11.11</Version>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms Condition="$(TargetFramework.StartsWith('net8.0-windows'))">true</UseWindowsForms>
    <UseWPF Condition="$(TargetFramework.StartsWith('net8.0-windows'))">true</UseWPF>
    <Platforms>x64</Platforms>
    <ApplicationManifest Condition="$(TargetFramework.StartsWith('net8.0-windows'))">app.manifest</ApplicationManifest>
    <!-- DPI awareness is declared in app.manifest (correct for our WPF + console hybrid).
         WFAC010 is the WinForms-only analyzer nudging toward Application.SetHighDpiMode; N/A here. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- In-process transcription (Phase 4). Replaces the Python cc-whisper. Model downloaded once. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net8.0-windows'))">
    <!-- Microphone capture (Mode A) -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- Windows TTS - used only by the self-test harness to inject known spoken words. -->
    <PackageReference Include="System.Speech" Version="8.0.0" />

    <!-- DPAPI (CurrentUser) protection for the stored DevThrottle dt_ key (issue #87). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Issue #102: the Linux build. The Windows-only engine files (GDI/WinForms/WPF screen work,
       NAudio WASAPI capture, DPAPI, System.Speech, the user32/shell32/kernel32 P/Invokes) are left
       out, and Platform/Linux supplies the same engine types over ffmpeg x11grab/pulse/v4l2 and the
       X server. The Windows build never compiles Platform/Linux, so nothing on Windows changes. -->
  <ItemGroup>
    <WindowsOnlyCompile Include="Screenshot.cs;RegionOverlay.cs;MonitorHighlight.cs;Monitors.cs;SelfTest.cs" />
    <WindowsOnlyCompile Include="Packaging\SpeechGen.cs;AlwaysOn\KillOnCloseJob.cs;AlwaysOn\ContinuousRecorder.cs" />
    <WindowsOnlyCompile Include="Audio\TonePlayer.cs;Audio\DefaultMic.cs;Audio\AudioCapture.cs;Audio\MicEndpoint.cs;Audio\LoopbackCapture.cs" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.StartsWith('net8.0-windows'))">
    <Compile Remove="@(WindowsOnlyCompile)" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net8.0-windows'))">
    <Compile Remove="Platform\Linux\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Let the test project and the WPF app see internal (engine) types. -->
    <InternalsVisibleTo Include="AgentEyes.Tests" />
    <InternalsVisibleTo Include="AgentEyes.Tests.Linux" />
    <InternalsVisibleTo Include="AgentEyesApp" />
  </ItemGroup>

  <ItemGroup>
    <!-- RNNoise model for ffmpeg's arnndn noise-suppression filter, extracted to
         %LOCALAPPDATA%\AgentEyes\models at first use (see Audio\RnnoiseModel.cs). -->
    <EmbeddedResource Include="..\..\assets\models\bd.rnnn" LogicalName="AgentEyes.Audio.bd.rnnn" />
  </ItemGroup>

</Project>
