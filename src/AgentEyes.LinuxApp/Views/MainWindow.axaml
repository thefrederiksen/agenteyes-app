<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentEyes.LinuxApp.ViewModels"
        x:Class="AgentEyes.LinuxApp.Views.MainWindow"
        Title="AgentEyes" Width="1280" Height="720" MinWidth="900" MinHeight="560"
        Icon="/Assets/agenteyes.png" WindowStartupLocation="CenterScreen">
  <!-- Issue #107: the Windows main window (AgentEyes.App/MainWindow.xaml) - icon rail, contextual
       top bar, and the Record / Library / Dictionary views. -->
  <Window.Resources>
    <ContextMenu x:Key="ItemMenu" x:DataType="vm:LibraryItem">
      <MenuItem Header="Preview" Click="Preview_Click" IsVisible="{Binding CanPreview}"/>
      <MenuItem Header="Details..." Click="Details_Click"/>
      <MenuItem Header="Rename..." Click="Rename_Click"/>
      <MenuItem Header="Export with subtitles..." Click="ExportSubtitles_Click" IsVisible="{Binding ShowTranscriptChip}"/>
      <MenuItem Header="Delete" Click="Delete_Click"/>
      <Separator/>
      <MenuItem Header="Open folder" Click="OpenFolder_Click"/>
      <MenuItem Header="Build walkthrough" Click="BuildWalkthrough_Click" IsVisible="{Binding CanBuildWalkthrough}"/>
    </ContextMenu>

    <!-- Grid mode: the Windows RecentCardTemplate -->
    <DataTemplate x:Key="CardTemplate" x:DataType="vm:LibraryItem">
      <Grid Width="236" Background="Transparent" ContextMenu="{StaticResource ItemMenu}" RowDefinitions="Auto,Auto,Auto,Auto"
            DoubleTapped="Card_DoubleTapped" ToolTip.Tip="Click to preview - right-click for actions">
        <Border Height="133" CornerRadius="6" Background="{StaticResource RdSurface}" BorderBrush="{StaticResource RdStroke}"
                BorderThickness="1" ClipToBounds="True" Classes="thumb">
          <Grid>
            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
            <TextBlock Text="{Binding Badge}" IsVisible="{Binding ShowPlaceholder}" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource RdMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border Background="{Binding BadgeBrush}" CornerRadius="3" Margin="7" Padding="5,1"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
              <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="White"/>
            </Border>
            <Border Background="#CC15171A" CornerRadius="3" Margin="7" Padding="5,1"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock Text="{Binding Duration}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="White"/>
            </Border>
            <Grid Name="Scrim" Background="#55000000" Opacity="0" IsHitTestVisible="False" IsVisible="{Binding CanPreview}">
              <Border Background="#AA15171A" CornerRadius="24" Width="48" Height="48">
                <Path Data="{Binding PreviewIcon}" Fill="White" Width="18" Height="18" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
              </Border>
            </Grid>
            <StackPanel Name="Quick" Orientation="Horizontal" Opacity="0" Margin="7,30,7,7"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
              <Button Classes="icon" ToolTip.Tip="Open folder" Margin="0,0,4,0" Click="OpenFolder_Click">
                <Path Data="M1,2 L6,2 L8,4 L15,4 L15,13 L1,13 Z" Fill="{StaticResource RdText}" Width="13" Height="10" Stretch="Uniform"/>
              </Button>
              <Button Classes="icon" ToolTip.Tip="More" Click="More_Click">
                <TextBlock Text="..." FontWeight="Bold" Margin="0,-6,0,0"/>
              </Button>
            </StackPanel>
            <Grid Background="#99000000" IsVisible="{Binding IsProcessing}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="110" Height="4" MinHeight="4" Foreground="{StaticResource RdAccent}"/>
                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,8,2,0"/>
        <TextBlock Grid.Row="2" Text="{Binding Detail}" FontSize="11" Classes="dim" TextTrimming="CharacterEllipsis" Margin="2,2,2,0"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,6,2,0">
          <TextBlock Text="{Binding Cost}" IsVisible="{Binding ShowCost}" FontFamily="{StaticResource Mono}" FontSize="10" Classes="muted"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button Classes="chip" Content="Transcript" IsVisible="{Binding ShowTranscriptChip}" Click="Details_Click" ToolTip.Tip="View transcript and details"/>
          <Button Classes="chip" Content="Text file" IsVisible="{Binding ShowFlatTextChip}" Click="Details_Click" ToolTip.Tip="Not transcribed - a text file exists"/>
          <Button Classes="chip chipAccent" IsVisible="{Binding ShowWalkthroughChip}" Click="OpenWalkthrough_Click" ToolTip.Tip="Open walkthrough">
            <StackPanel Orientation="Horizontal">
              <Path Data="M5,0 L6.2,3.8 L10,5 L6.2,6.2 L5,10 L3.8,6.2 L0,5 L3.8,3.8 Z" Fill="{StaticResource RdAccent}" Width="9" Height="9"
                    Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock Text="Walkthrough"/>
            </StackPanel>
          </Button>
          <Border BorderBrush="{StaticResource RdStroke}" BorderThickness="1" CornerRadius="9" Padding="7,1" IsVisible="{Binding IsProcessing}">
            <TextBlock Text="Processing..." FontSize="10" FontStyle="Italic" Classes="muted"/>
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- List mode: the Windows RecentRowTemplate -->
    <DataTemplate x:Key="RowTemplate" x:DataType="vm:LibraryItem">
      <Grid ColumnDefinitions="46,*,96,Auto" Background="Transparent" ContextMenu="{StaticResource ItemMenu}" DoubleTapped="Card_DoubleTapped">
        <Border Background="{Binding BadgeBrush}" CornerRadius="3" Width="38" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
          <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11" FontStyle="Italic" Foreground="{StaticResource RdAccent}" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <TextBlock Text="{Binding Detail}" FontSize="11" Classes="dim" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding Duration}" FontFamily="{StaticResource Mono}" FontSize="12" Classes="dim" HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding Cost}" IsVisible="{Binding ShowCost}" FontFamily="{StaticResource Mono}" FontSize="10" Classes="muted"
                     HorizontalAlignment="Right" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="icon" Margin="0,0,6,0" IsVisible="{Binding CanPreview}" ToolTip.Tip="{Binding PreviewTip}" Click="Preview_Click">
            <Path Data="{Binding PreviewIcon}" Fill="{StaticResource RdText}" Width="12" Height="12" Stretch="Uniform"/>
          </Button>
          <Button Classes="mini" Content="Open" Width="60" Click="OpenFolder_Click"/>
          <Button Classes="mini" Content="Walkthrough" Width="100" Margin="6,0,0,0" IsVisible="{Binding ShowWalkthroughChip}" Click="OpenWalkthrough_Click"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="ListBox.grid ListBoxItem:pointerover Grid#Scrim">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ListBox.grid ListBoxItem:pointerover StackPanel#Quick">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="72,*">
    <!-- ============ ICON RAIL ============ -->
    <Border Background="{StaticResource RdSurface}" BorderBrush="{StaticResource RdStroke}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
          <RadioButton Name="RailRecord" Classes="rail railRecord" GroupName="Rail" IsChecked="True" Tag="Record"
                       ToolTip.Tip="Record" IsCheckedChanged="Rail_Changed">
            <StackPanel Spacing="3">
              <Panel Width="20" Height="20">
                <Ellipse Width="18" Height="18" StrokeThickness="1.8" Stroke="{Binding $parent[RadioButton].Foreground}"/>
                <Ellipse Width="8" Height="8" Fill="{Binding $parent[RadioButton].Foreground}"/>
              </Panel>
              <TextBlock Text="Record" Classes="railLabel"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Name="RailLibrary" Classes="rail" GroupName="Rail" Tag="Library" ToolTip.Tip="Library" IsCheckedChanged="Rail_Changed">
            <StackPanel Spacing="3">
              <Path Width="18" Height="18" Stretch="Uniform" Data="M3,3 h7 v7 h-7 Z M14,3 h7 v7 h-7 Z M3,14 h7 v7 h-7 Z M14,14 h7 v7 h-7 Z"
                    Fill="{Binding $parent[RadioButton].Foreground}" HorizontalAlignment="Center"/>
              <TextBlock Text="Library" Classes="railLabel"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Name="RailDictionary" Classes="rail" GroupName="Rail" Tag="Dictionary"
                       ToolTip.Tip="Dictionary - the terms transcription must get right" IsCheckedChanged="Rail_Changed">
            <StackPanel Spacing="3">
              <Path Width="20" Height="18" Stretch="Uniform" StrokeThickness="1.6" HorizontalAlignment="Center"
                    Data="M10,4 C8,2.6 5,2.2 2,3 v13 c3,-0.8 6,-0.4 8,1 c2,-1.4 5,-1.8 8,-1 V3 c-3,-0.8 -6,-0.4 -8,1 Z M10,4 v13"
                    Stroke="{Binding $parent[RadioButton].Foreground}"/>
              <TextBlock Text="Dictionary" Classes="railLabel"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
          <Button Name="RailAccount" Classes="railAction" Click="Account_Click" ToolTip.Tip="DevThrottle account">
            <StackPanel Spacing="3">
              <Panel Width="22" Height="20">
                <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M12,12 C14.2,12 16,10.2 16,8 C16,5.8 14.2,4 12,4 C9.8,4 8,5.8 8,8 C8,10.2 9.8,12 12,12 Z M12,14 C8.7,14 4,15.6 4,18.5 V20 H20 V18.5 C20,15.6 15.3,14 12,14 Z"
                      Stroke="{Binding $parent[Button].Foreground}"/>
                <Panel Name="RailAccountBadge" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" IsVisible="False">
                  <Ellipse Fill="#E8A33D"/>
                  <TextBlock Text="!" FontSize="8" FontWeight="Bold" Foreground="#1B1D21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Panel>
              </Panel>
              <TextBlock Name="RailAccountLabel" Text="Account" Classes="railLabel"/>
            </StackPanel>
          </Button>
          <Button Classes="railAction" Click="Settings_Click" ToolTip.Tip="Settings">
            <StackPanel Spacing="3">
              <Path Width="17" Height="17" Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center"
                    Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
              <TextBlock Text="Settings" Classes="railLabel"/>
            </StackPanel>
          </Button>
          <Button Classes="railAction" Click="About_Click" ToolTip.Tip="About AgentEyes">
            <StackPanel Spacing="3">
              <TextBlock Text="?" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}"/>
              <TextBlock Text="Help" Classes="railLabel"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ TOP BAR + CONTENT ============ -->
    <Grid Grid.Column="1" RowDefinitions="52,*">
      <Border BorderBrush="{StaticResource RdStroke}" BorderThickness="0,0,0,1">
        <DockPanel Margin="24,0,16,0">
          <TextBlock Name="ViewTitle" Text="Record" Classes="h1" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Classes="icon" ToolTip.Tip="More" VerticalAlignment="Center">
            <TextBlock Text="..." FontWeight="Bold" Margin="0,-6,0,0"/>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Open recordings folder" Click="OpenRecordings_Click"/>
                <MenuItem Header="Refresh library" Click="RefreshLibrary_Click"/>
                <Separator/>
                <MenuItem Header="About AgentEyes" Click="About_Click"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <StackPanel Name="LibraryControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="False" Margin="0,0,10,0">
            <TextBlock Name="LibraryCountText" FontSize="12" Classes="dim" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBox Name="SearchBox" Width="200" Height="30" Watermark="Search" Margin="0,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
            <Button Name="GridModeButton" Classes="icon" ToolTip.Tip="Grid view" Click="GridMode_Click" Margin="0,0,4,0">
              <Path Data="M0,0 h5 v5 h-5 Z M8,0 h5 v5 h-5 Z M0,8 h5 v5 h-5 Z M8,8 h5 v5 h-5 Z" Fill="{StaticResource RdText}" Width="12" Height="12" Stretch="Uniform"/>
            </Button>
            <Button Name="ListModeButton" Classes="icon" ToolTip.Tip="List view" Click="ListMode_Click" Opacity="0.45">
              <Path Data="M0,0 h13 v2.4 h-13 Z M0,5.3 h13 v2.4 h-13 Z M0,10.6 h13 v2.4 h-13 Z" Fill="{StaticResource RdText}" Width="12" Height="12" Stretch="Uniform"/>
            </Button>
          </StackPanel>
          <TextBlock Name="StatusText" DockPanel.Dock="Right" FontSize="12" Classes="dim" VerticalAlignment="Center"
                     Margin="16,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
        </DockPanel>
      </Border>

      <Panel Grid.Row="1">
        <!-- ===== RECORD VIEW ===== -->
        <ScrollViewer Name="RecordPanel">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560" Margin="0,30">
            <Border Name="OfflineBanner" Background="{StaticResource RdAmberSurface}" BorderBrush="{StaticResource RdAmber}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,22" IsVisible="False">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="mini" Content="Start the recorder" Click="StartService_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Name="OfflineText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RdAmber}" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <Button Name="RecordButton" Classes="recHero" HorizontalAlignment="Center" Click="Record_Click">
              <Panel>
                <Ellipse Width="114" Height="114" Stroke="#40FFFFFF" StrokeThickness="1.5"/>
                <TextBlock Name="RecordText" Text="REC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Panel>
            </Button>
            <TextBlock Name="ElapsedText" FontFamily="{StaticResource Mono}" FontSize="15" Foreground="{StaticResource RdRecord}"
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>

            <!-- Capture setup: the Linux stand-in for the preset (assumption A2) -->
            <Border Name="SetupCard" Background="{StaticResource RdSurface}" BorderBrush="{StaticResource RdStroke}" BorderThickness="1"
                    CornerRadius="8" Padding="18,14" Margin="0,18,0,0">
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="Screen" Classes="dim" FontSize="12" VerticalAlignment="Center"/>
                <ComboBox Name="ScreenCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Setup_Changed"/>
                <TextBlock Grid.Row="1" Text="Microphone" Classes="dim" FontSize="12" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox Name="MicCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,10,0,0" SelectionChanged="Setup_Changed"/>
                <TextBlock Grid.Row="2" Text="System sound" Classes="dim" FontSize="12" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ToggleSwitch Name="SystemToggle" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" OnContent="Recorded" OffContent="Not recorded"
                              IsCheckedChanged="Setup_Changed"/>
              </Grid>
            </Border>

            <StackPanel Name="CaptureChips" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" Spacing="10"/>
            <TextBlock Name="CaptureScreenText" FontSize="11" Classes="dim" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <Canvas Name="MonitorStrip" Width="320" Height="72" HorizontalAlignment="Center" Margin="0,8,0,0"/>

            <Grid Name="LevelPanel" ColumnDefinitions="32,*" RowDefinitions="Auto,Auto" Margin="60,18,60,0" IsVisible="False">
              <TextBlock Text="MIC" FontSize="10" FontFamily="{StaticResource Mono}" Classes="muted" VerticalAlignment="Center"/>
              <ProgressBar Name="MicLevelBar" Grid.Column="1" Height="6" MinHeight="6" Minimum="0" Maximum="100" Foreground="{StaticResource RdAccent}"/>
              <TextBlock Grid.Row="1" Text="SYS" FontSize="10" FontFamily="{StaticResource Mono}" Classes="muted" VerticalAlignment="Center" Margin="0,4,0,0"/>
              <ProgressBar Name="SysLevelBar" Grid.Row="1" Grid.Column="1" Height="6" MinHeight="6" Minimum="0" Maximum="100" Foreground="{StaticResource RdAccent}" Margin="0,4,0,0"/>
            </Grid>
            <TextBlock Text="Recordings are automatically transcribed and titled." Classes="muted" FontSize="11" HorizontalAlignment="Center" Margin="0,22,0,0"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== LIBRARY VIEW ===== -->
        <Panel Name="LibraryPanel" Margin="24,12,8,0" IsVisible="False">
          <ListBox Name="RecentList" Classes="library grid" SelectionMode="Multiple,Toggle" KeyDown="RecentList_KeyDown"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="RecentList_SelectionChanged"/>
          <StackPanel Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
            <Path Data="M3,3 h7 v7 h-7 Z M14,3 h7 v7 h-7 Z M3,14 h7 v7 h-7 Z M14,14 h7 v7 h-7 Z" Fill="{StaticResource RdStroke}"
                  Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Center"/>
            <TextBlock Name="EmptyTitle" Text="No recordings yet." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock Name="EmptyText" Text="Everything you capture lands here, transcribed and titled automatically." FontSize="12" Classes="dim"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <Button Name="EmptyButton" Content="Start your first recording" Classes="primary" HorizontalAlignment="Center" Margin="0,18,0,0" Click="GoRecord_Click"/>
          </StackPanel>
          <TextBlock Name="LibraryLoading" Text="Loading..." Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Panel>

        <!-- ===== DICTIONARY VIEW ===== -->
        <DockPanel Name="DictionaryPanel" Margin="24,16,24,16" IsVisible="False">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Terms the transcription must get right - product names, people, jargon. Add how it gets misheard and the transcript is corrected."
                       TextWrapping="Wrap" Classes="dim" FontSize="12" Margin="0,0,0,12"/>
            <DockPanel Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Content="Add" Classes="primary" Click="AddTerm_Click" Margin="8,0,0,0"/>
              <TextBox Name="NewTermBox" Watermark="Add a term (e.g. a product name)" KeyDown="NewTermBox_KeyDown"/>
            </DockPanel>
            <TextBox Name="DictSearchBox" Watermark="Search terms" Width="240" HorizontalAlignment="Left" Margin="0,0,0,10"/>
          </StackPanel>
          <Panel>
            <ScrollViewer>
              <ItemsControl Name="DictList"/>
            </ScrollViewer>
            <TextBlock Name="DictEmpty" Text="No terms yet." Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
          </Panel>
        </DockPanel>
      </Panel>
    </Grid>
  </Grid>
</Window>
