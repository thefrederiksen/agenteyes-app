<Window x:Class="AgentEyes.App.PresetEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit preset" Height="760" Width="1000"
        MinHeight="420" MinWidth="820"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource DkBg}" FontFamily="Segoe UI">
    <!-- Issue #35: the editor was one tall 480px column with a permanent scrollbar down its right
         edge. It is now a generously sized TABBED window - Capture / Audio / Camera - with the
         preset's identity (name, note) in a header that stays put above the tabs, so it is visible
         whichever tab you are on.

         Each tab keeps its own ScrollViewer as the small-screen safety net; at the default window
         size none of them engages. The Camera tab carries the live preview pane from issue #29 -
         a framing check you can run BEFORE recording - and is where the circular overlay controls
         from issue #36 will land. -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Identity: outside the tabs, always visible ===================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="NAME" Style="{StaticResource DkSection}" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox" Style="{StaticResource DkTextBox}" Height="32"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="NOTE (optional)" Style="{StaticResource DkSection}" Margin="0,0,0,6"/>
                <TextBox x:Name="NoteBox" Style="{StaticResource DkTextBox}" Height="32"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="EditorTabs" Grid.Row="1" Style="{StaticResource DkTab}" Margin="0,20,0,0"
                    SelectionChanged="EditorTabs_Changed">

            <!-- ================================ CAPTURE ================================ -->
            <TabItem x:Name="CaptureTab" Header="Capture" Style="{StaticResource DkTabItem}">
                <ScrollViewer x:Name="CaptureScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="CAPTURE SOURCE" Style="{StaticResource DkSection}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MonitorBox" Style="{StaticResource DkCombo}" Height="32"/>
                            <Button Grid.Column="1" x:Name="ShowAreaButton" Content="Show area"
                                    Style="{StaticResource DkMini}" Margin="8,0,0,0" Click="ShowArea_Click"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton x:Name="FullRadio" Content="Full monitor" IsChecked="True"
                                         Style="{StaticResource DkRadio}" GroupName="src" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RegionRadio" Content="Region" GroupName="src"
                                         Style="{StaticResource DkRadio}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <Button x:Name="SelectAreaButton" Content="Select area..." Style="{StaticResource DkMini}"
                                    Margin="12,0,0,0" Click="SelectArea_Click" IsEnabled="False"/>
                            <TextBlock x:Name="RegionLabel" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{StaticResource DkDim}" FontSize="11"/>
                        </StackPanel>

                        <!-- Region framing: aspect lock, exact size, social-format quick presets (issue #69) -->
                        <StackPanel x:Name="RegionOptions" IsEnabled="False" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Aspect lock" VerticalAlignment="Center" Width="72"
                                           Foreground="{StaticResource DkDim}" FontSize="11"/>
                                <ComboBox x:Name="AspectBox" Style="{StaticResource DkCombo}" Width="150" Height="28"
                                          FontSize="12" VerticalAlignment="Center">
                                    <ComboBoxItem IsSelected="True">Free</ComboBoxItem>
                                    <ComboBoxItem>Square (1:1)</ComboBoxItem>
                                    <ComboBoxItem>Landscape (16:9)</ComboBoxItem>
                                    <ComboBoxItem>Vertical (9:16)</ComboBoxItem>
                                </ComboBox>
                                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                                           Foreground="{StaticResource DkDim}"
                                           Text="constrains 'Select area...' drag"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Exact size" VerticalAlignment="Center" Width="72"
                                           Foreground="{StaticResource DkDim}" FontSize="11"/>
                                <TextBox x:Name="ExactWidthBox" Style="{StaticResource DkTextBox}" Width="64" Height="28"
                                         FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="x" VerticalAlignment="Center" Margin="6,0,6,0"
                                           Foreground="{StaticResource DkDim}" FontSize="12"/>
                                <TextBox x:Name="ExactHeightBox" Style="{StaticResource DkTextBox}" Width="64" Height="28"
                                         FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource DkDim}" FontSize="11"/>
                                <Button x:Name="SetExactButton" Content="Set" Style="{StaticResource DkMini}"
                                        Margin="10,0,0,0" MinWidth="56" Click="SetExact_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Quick" VerticalAlignment="Center" Width="72"
                                           Foreground="{StaticResource DkDim}" FontSize="11"/>
                                <Button x:Name="SquareButton" Content="Square 1080x1080" Style="{StaticResource DkMini}"
                                        Click="QuickSquare_Click"/>
                                <Button x:Name="VerticalButton" Content="Vertical 1080x1920" Style="{StaticResource DkMini}"
                                        Margin="8,0,0,0" Click="QuickVertical_Click"/>
                                <Button x:Name="LandscapeButton" Content="Landscape 1920x1080" Style="{StaticResource DkMini}"
                                        Margin="8,0,0,0" Click="QuickLandscape_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="RegionWarn" Foreground="{StaticResource DkRed}" FontSize="11"
                                       Margin="72,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Mode: what a recording produces, and (for video) at what frame rate -->
                        <TextBlock Text="MODE" Style="{StaticResource DkSection}" Margin="0,24,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeShot" Content="Screenshot" GroupName="mode"
                                         Style="{StaticResource DkRadio}" VerticalAlignment="Center" Checked="Mode_Changed"/>
                            <RadioButton x:Name="ModeAudio" Content="Audio + shots" GroupName="mode"
                                         Style="{StaticResource DkRadio}" Margin="14,0,0,0" VerticalAlignment="Center" Checked="Mode_Changed"/>
                            <RadioButton x:Name="ModeVideo" Content="Video" GroupName="mode" IsChecked="True"
                                         Style="{StaticResource DkRadio}" Margin="14,0,0,0" VerticalAlignment="Center" Checked="Mode_Changed"/>
                            <TextBlock Text="fps" VerticalAlignment="Center" Margin="20,0,6,0"
                                       Foreground="{StaticResource DkDim}" FontSize="11"/>
                            <ComboBox x:Name="FpsBox" Style="{StaticResource DkCombo}" Width="68" Height="28"
                                      FontSize="12" VerticalAlignment="Center">
                                <ComboBoxItem>15</ComboBoxItem>
                                <ComboBoxItem>24</ComboBoxItem>
                                <ComboBoxItem IsSelected="True">30</ComboBoxItem>
                                <ComboBoxItem>60</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================= AUDIO ================================= -->
            <TabItem x:Name="AudioTab" Header="Audio" Style="{StaticResource DkTabItem}">
                <ScrollViewer x:Name="AudioScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="MICROPHONE" Style="{StaticResource DkSection}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="MicBox" Style="{StaticResource DkCombo}" Height="32"
                                  HorizontalAlignment="Left" MinWidth="420" MaxWidth="560"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <RadioButton x:Name="SrcMic" Content="Mic only" GroupName="asrc"
                                         Style="{StaticResource DkRadio}" VerticalAlignment="Center" Checked="AudioSrc_Changed"/>
                            <RadioButton x:Name="SrcSystem" Content="System only" GroupName="asrc"
                                         Style="{StaticResource DkRadio}" Margin="14,0,0,0" VerticalAlignment="Center" Checked="AudioSrc_Changed"/>
                            <RadioButton x:Name="SrcMixed" Content="Mic + System" GroupName="asrc" IsChecked="True"
                                         Style="{StaticResource DkRadio}" Margin="14,0,0,0" VerticalAlignment="Center" Checked="AudioSrc_Changed"/>
                        </StackPanel>

                        <TextBlock Text="CLEAN-UP" Style="{StaticResource DkSection}" Margin="0,24,0,6"/>
                        <CheckBox x:Name="DenoiseCheck" Content="Noise suppression (removes fan/hum/background noise)"
                                  Style="{StaticResource DkCheck}" IsChecked="True"/>
                        <CheckBox x:Name="GateCheck" Content="Noise gate (mutes mic between phrases)"
                                  Style="{StaticResource DkCheck}" IsChecked="True" Margin="0,10,0,0"/>
                        <CheckBox x:Name="LevelCheck" Content="Voice leveling (evens out loud and quiet speech)"
                                  Style="{StaticResource DkCheck}" IsChecked="True" Margin="0,10,0,0"/>

                        <TextBlock Text="MIX" Style="{StaticResource DkSection}" Margin="0,24,0,6"/>
                        <Grid HorizontalAlignment="Left" MinWidth="420" MaxWidth="560">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Mic vol" VerticalAlignment="Center" Foreground="{StaticResource DkDim}" FontSize="11"/>
                            <Slider x:Name="MicVol" Grid.Column="1" Minimum="0" Maximum="150" Value="100"
                                    Margin="8,0" VerticalAlignment="Center" ValueChanged="Vol_Changed"/>
                            <TextBlock x:Name="MicVolText" Grid.Column="2" Text="100%" Width="40"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="11" Foreground="{StaticResource DkDim}"/>
                            <TextBlock Grid.Row="1" Text="Sys vol" VerticalAlignment="Center" Foreground="{StaticResource DkDim}" FontSize="11"/>
                            <Slider x:Name="SysVol" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="150" Value="70"
                                    Margin="8,0" VerticalAlignment="Center" ValueChanged="Vol_Changed"/>
                            <TextBlock x:Name="SysVolText" Grid.Row="1" Grid.Column="2" Text="70%" Width="40"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="11" Foreground="{StaticResource DkDim}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================= CAMERA ================================= -->
            <!-- Camera: recorded to its own camera.mp4 alongside the screen video (issue #28), and
                 previewed live here BEFORE recording (issue #29). A DirectShow camera is EXCLUSIVE,
                 so the device is released the moment the selection changes, this tab is left, the
                 preset leaves Video mode, a recording starts, or the dialog closes by any route.

                 Issue #36 adds the OVERLAY FRAMING controls beside that pane: the circle's centre
                 and diameter within the camera frame, the shape, the corner and the on-screen size.
                 They change the PREVIEW and the recording's edit metadata only - never camera.mp4,
                 which keeps its full rectangular frame at its normal resolution. -->
            <TabItem x:Name="CameraTab" Header="Camera" Style="{StaticResource DkTabItem}">
                <ScrollViewer x:Name="CameraScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="CAMERA" Style="{StaticResource DkSection}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Camera" VerticalAlignment="Center" Width="72"
                                       Foreground="{StaticResource DkDim}" FontSize="11"/>
                            <ComboBox x:Name="CameraBox" Style="{StaticResource DkCombo}" Width="360" Height="30"
                                      FontSize="12" VerticalAlignment="Center" SelectionChanged="Camera_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="CameraHint" Margin="72,8,0,0" TextWrapping="Wrap" MaxWidth="620"
                                   HorizontalAlignment="Left"
                                   Foreground="{StaticResource DkDim}" FontSize="11"
                                   Text="Recorded to its own camera.mp4 (video only) next to the screen video, so both can be composed later. Video mode only."/>

                        <TextBlock Text="LIVE PREVIEW AND OVERLAY FRAMING" Style="{StaticResource DkSection}" Margin="0,20,0,6"/>

                        <!-- Issue #36. The circle is chosen HERE, against the live image, because a
                             webcam is never framed with the speaker's head dead centre - a fixed
                             centre crop cuts heads in half. The pane and the controls sit side by
                             side so the framing is visible while it is being chosen (AC2).

                             The circle is a FRAMING CHOICE, NOT A CROP (assumption E1): camera.mp4
                             keeps recording the full rectangular frame whatever is set here. -->
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border x:Name="CameraPreviewPanel" Width="480" Height="360"
                                        HorizontalAlignment="Left" Background="{StaticResource DkCard}"
                                        BorderBrush="{StaticResource DkBorder}" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="CameraPreviewImage" Stretch="Uniform"/>
                                        <!-- The circle drawn over the live image. It is hit-testable
                                             so the centre can be placed by clicking or dragging on
                                             the picture, which is the natural way to say "my face is
                                             HERE"; the sliders remain the authoritative value and are
                                             what UI Automation drives. -->
                                        <Canvas x:Name="CameraOverlayAdorner" Background="Transparent"
                                                MouseLeftButtonDown="OverlayAdorner_MouseDown"
                                                MouseMove="OverlayAdorner_MouseMove"
                                                MouseLeftButtonUp="OverlayAdorner_MouseUp"
                                                SizeChanged="OverlayAdorner_SizeChanged">
                                            <Path x:Name="OverlayMaskPath" Fill="#A6000000" IsHitTestVisible="False"/>
                                            <Path x:Name="OverlayOutlinePath" Stroke="{StaticResource DkAccent}"
                                                  StrokeThickness="2" IsHitTestVisible="False"/>
                                        </Canvas>
                                        <TextBlock x:Name="CameraPreviewStatus" Text="No camera selected."
                                                   Foreground="{StaticResource DkDim}" FontSize="11" Margin="10"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" MaxWidth="480"
                                           HorizontalAlignment="Left" Foreground="{StaticResource DkDim}"
                                           Text="The preview runs only while this tab is open. Leaving the tab or closing this window hands the camera straight back, so a recording can take it."/>
                            </StackPanel>

                            <StackPanel x:Name="OverlayControls" Grid.Column="1" Width="420" Margin="20,0,0,0">
                                <TextBlock Text="Shape" Foreground="{StaticResource DkDim}" FontSize="11"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <RadioButton x:Name="OverlayShapeCircle" Content="Circle" GroupName="ovshape"
                                                 IsChecked="True" Style="{StaticResource DkRadio}"
                                                 VerticalAlignment="Center" Checked="OverlayShape_Changed"/>
                                    <RadioButton x:Name="OverlayShapeRectangle" Content="Rectangle (whole frame)"
                                                 GroupName="ovshape" Style="{StaticResource DkRadio}"
                                                 Margin="16,0,0,0" VerticalAlignment="Center" Checked="OverlayShape_Changed"/>
                                </StackPanel>

                                <StackPanel x:Name="CircleControls" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Left / right" VerticalAlignment="Center" Width="80"
                                                   Foreground="{StaticResource DkDim}" FontSize="11"/>
                                        <Slider x:Name="CircleXSlider" Grid.Column="1" Minimum="0" Maximum="1"
                                                Value="0.5" SmallChange="0.01" LargeChange="0.05"
                                                Margin="8,0" VerticalAlignment="Center" ValueChanged="Overlay_Changed"/>
                                        <TextBlock x:Name="CircleXText" Grid.Column="2" Text="50%" Width="44"
                                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource DkDim}"/>

                                        <TextBlock Grid.Row="1" Text="Up / down" VerticalAlignment="Center" Width="80"
                                                   Foreground="{StaticResource DkDim}" FontSize="11"/>
                                        <Slider x:Name="CircleYSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1"
                                                Value="0.42" SmallChange="0.01" LargeChange="0.05"
                                                Margin="8,0" VerticalAlignment="Center" ValueChanged="Overlay_Changed"/>
                                        <TextBlock x:Name="CircleYText" Grid.Row="1" Grid.Column="2" Text="42%" Width="44"
                                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource DkDim}"/>

                                        <TextBlock Grid.Row="2" Text="Diameter" VerticalAlignment="Center" Width="80"
                                                   Foreground="{StaticResource DkDim}" FontSize="11"/>
                                        <Slider x:Name="CircleSizeSlider" Grid.Row="2" Grid.Column="1" Minimum="0.1" Maximum="1"
                                                Value="0.6" SmallChange="0.01" LargeChange="0.05"
                                                Margin="8,0" VerticalAlignment="Center" ValueChanged="Overlay_Changed"/>
                                        <TextBlock x:Name="CircleSizeText" Grid.Row="2" Grid.Column="2" Text="60%" Width="44"
                                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource DkDim}"/>
                                    </Grid>
                                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource DkDim}"
                                               Text="Click or drag on the picture to put the circle over your face. Diameter is a share of the camera frame's height."/>
                                </StackPanel>

                                <TextBlock Text="Where it sits on the recording preview" Margin="0,18,0,0"
                                           Foreground="{StaticResource DkDim}" FontSize="11"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Corner" VerticalAlignment="Center" Width="80"
                                               Foreground="{StaticResource DkDim}" FontSize="11"/>
                                    <ComboBox x:Name="OverlayCornerBox" Style="{StaticResource DkCombo}" Width="150" Height="28"
                                              FontSize="12" VerticalAlignment="Center" SelectionChanged="OverlayCorner_Changed">
                                        <ComboBoxItem IsSelected="True">Bottom right</ComboBoxItem>
                                        <ComboBoxItem>Bottom left</ComboBoxItem>
                                        <ComboBoxItem>Top left</ComboBoxItem>
                                        <ComboBoxItem>Top right</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Size on screen" VerticalAlignment="Center" Width="80"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource DkDim}" FontSize="11"/>
                                    <Slider x:Name="InsetSizeSlider" Grid.Column="1" Minimum="0.15" Maximum="0.6"
                                            Value="0.3" SmallChange="0.01" LargeChange="0.05"
                                            Margin="8,0" VerticalAlignment="Center" ValueChanged="Overlay_Changed"/>
                                    <TextBlock x:Name="InsetSizeText" Grid.Column="2" Text="30%" Width="44"
                                               VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource DkDim}"/>
                                </Grid>

                                <Button x:Name="OverlayResetButton" Content="Reset framing" Style="{StaticResource DkMini}"
                                        HorizontalAlignment="Left" Margin="0,16,0,0" Click="OverlayReset_Click"/>

                                <TextBlock x:Name="OverlayHint" Margin="0,14,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource DkDim}"
                                           Text="The circle is a framing choice, not a crop: camera.mp4 still records the whole rectangular frame, and the circle is written into the recording's manifest so the framing can be reproduced - or moved - later."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DkRed}" VerticalAlignment="Center"
                       Margin="0,0,12,0" FontSize="11"/>
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource DkPrimary}" MinWidth="86" Click="Save_Click"/>
            <Button x:Name="SaveAsButton" Content="Save as..." Style="{StaticResource DkMini}" MinWidth="86"
                    Margin="8,0,0,0" Click="SaveAs_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DkMini}" MinWidth="86"
                    Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
