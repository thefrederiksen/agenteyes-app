<Window x:Class="AgentEyes.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Height="640" Width="1000" MinHeight="200" MinWidth="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource DkBg}" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <!-- Transport bar (hidden for screenshots) -->
        <Border DockPanel.Dock="Bottom" x:Name="ControlsBar" Background="{StaticResource DkBar}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayButton" Style="{StaticResource DkIcon}" Focusable="False"
                        Click="PlayPause_Click" ToolTip="Play / pause (Space)">
                    <Path x:Name="PlayGlyph" Fill="{StaticResource DkText}" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource DkIcon}" Focusable="False" Margin="6,0,0,0"
                        Click="Restart_Click" ToolTip="Restart from the beginning">
                    <Path Data="M 6 4 L 8.5 4 L 8.5 20 L 6 20 Z M 20 4 L 9.5 12 L 20 20 Z"
                          Fill="{StaticResource DkText}" Width="12" Height="12" Stretch="Uniform"/>
                </Button>

                <Slider x:Name="SeekBar" Grid.Column="2" Margin="14,0" VerticalAlignment="Center"
                        Minimum="0" Maximum="100" IsMoveToPointEnabled="True" ValueChanged="Seek_Changed"/>

                <TextBlock x:Name="TimeText" Grid.Column="3" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource DkDim}" VerticalAlignment="Center" Text="0:00 / 0:00"/>
            </Grid>
        </Border>

        <!-- Media area: video/audio (MediaElement), screenshot (Image), or an error -->
        <Grid Background="#161616">
            <MediaElement x:Name="Media" LoadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                          MediaOpened="Media_Opened" MediaEnded="Media_Ended" MediaFailed="Media_Failed"/>
            <Image x:Name="Still" Stretch="Uniform" Visibility="Collapsed" Margin="8"/>
            <!-- Big quiet speaker glyph so an audio-only preview is not a black void -->
            <Path x:Name="AudioGlyph" Visibility="Collapsed" Fill="#3C3C3C" Width="84" Height="84"
                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M 3 9 L 7 9 L 12 4 L 12 20 L 7 15 L 3 15 Z M 15.5 7 C 18.5 9 18.5 15 15.5 17 L 14.4 15.8 C 16.6 14.2 16.6 9.8 14.4 8.2 Z"/>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource DkRed}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                       TextWrapping="Wrap" Margin="30"/>
        </Grid>
    </DockPanel>
</Window>
