<UserControl x:Class="AgentEyesSetup.Steps.InstallStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText"
                       Text="Installing"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,20">
                <TextBlock x:Name="StatusText"
                           Text="Preparing..."
                           Foreground="{StaticResource TextForeground}"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <Button x:Name="RepairButton"
                        Content="Repair"
                        Width="90" Margin="16,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="RepairButton_Click"
                        Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

        <!-- Log location (visible DURING install, so a stuck/hung run can still be diagnosed). -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="LogFooter"
                       Foreground="#666666"
                       FontSize="11"
                       TextWrapping="Wrap" />
            <Button x:Name="OpenLogButton" Content="Open log folder" Padding="10,3"
                    Margin="0,6,0,0" HorizontalAlignment="Left" Click="OpenLogButton_Click" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ComponentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2D2E" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AssetName}"
                                               Foreground="#888888"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding StatusDetail}"
                                               Foreground="#CC8844"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SizeText}"
                                               Foreground="#888888" FontSize="11"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#CCCCCC" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                                        <Setter Property="Foreground" Value="#22C55E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                        <Setter Property="Foreground" Value="#007ACC" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Foreground" Value="#CC4444" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                        <Setter Property="Foreground" Value="#888888" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
