<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows: the engine touches the registry (PATH, Run key, the Add/Remove
         Programs entry) and the product is Windows-only. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AgentEyes.Setup.Engine</AssemblyName>
    <RootNamespace>AgentEyes.Setup.Engine</RootNamespace>
  </PropertyGroup>

</Project>
