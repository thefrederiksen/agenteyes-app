<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows: the engine touches the registry (PATH, Run key, the Add/Remove
         Programs entry) and the product is Windows-only. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AgentEyes.Setup.Engine</AssemblyName>
    <RootNamespace>AgentEyes.Setup.Engine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Issue #86: the update reads the running app's command line (Win32_Process.CommandLine) so
         it can start the app again exactly as it was running. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
