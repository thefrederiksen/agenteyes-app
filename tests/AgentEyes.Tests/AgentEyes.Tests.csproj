<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <RootNamespace>AgentEyes.Tests</RootNamespace>
    <AssemblyName>AgentEyes.Tests</AssemblyName>
    <!-- Issue #94: the test SDK's generated empty Main is switched off so LaunchProbe.Main is the
         assembly's entry point. ProcessAppLauncherTests runs this assembly as a separate process
         (dotnet AgentEyes.Tests.dll launch-probe ...) with its stdout piped, standing in for the
         updater, to prove that the app the launcher starts holds no copy of that pipe. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- StopPathTests (issue #151) reads the App/Core SOURCE to prove that no caller bypasses the
         one shared stop operation: a call site is a source fact, not a runtime one, so the repo root
         is stamped in at build time rather than guessed from the working directory at run time. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentEyes.Core\AgentEyes.Core.csproj" />
    <ProjectReference Include="..\..\tools\AgentEyes.Setup.Engine\AgentEyes.Setup.Engine.csproj" />
    <!-- The setup CLI is referenced so SetupCliHelpTests (issue #83) can run its REAL entry point
         (Program.RunAsync) in-process: "install" with the help switch must print help and reach neither
         the release channel nor the install root, and that is only provable through the dispatch the
         exe runs. -->
    <ProjectReference Include="..\..\tools\AgentEyes.Setup.Cli\AgentEyes.Setup.Cli.csproj" />
    <!-- The setup wizard is referenced so WizardInstallRunnerTests (issue #86 review, N1) can drive its
         EngineInstallRunner in-process with a fake running-app handle: every failure of the update cycle
         must become one error state the window shows, never a hang at "Installing...". The WPF wizard is
         never started; only the runner class is used. -->
    <ProjectReference Include="..\..\tools\AgentEyes.Setup\AgentEyes.Setup.csproj" />
    <!-- AgentEyes.App is referenced ONLY so MSBuild builds it first and drops AgentEyesApp.dll next
         to the tests. The WPF app is never loaded or started - ManifestWriterIlTests reads its IL as
         bytes (issue #155, criterion 4), and the reference is what makes that a FRESH binary instead
         of whatever is left in some bin directory. -->
    <ProjectReference Include="..\..\src\AgentEyes.App\AgentEyes.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #122: pure argument-parsing tests shared by all three suites (Windows, Linux, macOS),
         compiled from ONE source file so every platform's build of the CLI passes the same ones. -->
    <Compile Include="..\Shared\CliDispatcherTests.cs" Link="Shared\CliDispatcherTests.cs" />
    <!-- Issue #113: the platform-neutral capture watchdog, tested once for all three platforms. -->
    <Compile Include="..\Shared\CaptureWatchdogTests.cs" Link="Shared\CaptureWatchdogTests.cs" />
    <Compile Include="..\Shared\CaptureWatchdogWiringTests.cs" Link="Shared\CaptureWatchdogWiringTests.cs" />
    <Compile Include="..\Shared\RecordingStopOrderTests.cs" Link="Shared\RecordingStopOrderTests.cs" />

    <Compile Include="..\Shared\MuxLockTests.cs" Link="Shared\MuxLockTests.cs" />
    <!-- Issue #161: the library-redirect rules, /status roots, and a real child process refusing a
         partial redirect - linked into all three suites so each platform's engine is held to them. -->
    <Compile Include="..\Shared\LibraryRedirectTests.cs" Link="Shared\LibraryRedirectTests.cs" />
    <Compile Include="..\Shared\CaptureOwnershipTests.cs" Link="Shared\CaptureOwnershipTests.cs" />
    <Compile Include="..\Shared\CaptureWriterReapTests.cs" Link="Shared\CaptureWriterReapTests.cs" />
    <Compile Include="..\Shared\ProcessIdentityTests.cs" Link="Shared\ProcessIdentityTests.cs" />

    <!-- Issue #136: ONE guard, compiled into all three suites. FfmpegMuxShapeTests sweeps the
         argument builders in THIS build - which is the whole point of linking it rather than
         duplicating it: each suite's sweep sees its own platform's FfmpegArgs partial, so the macOS
         and Linux builders are covered by the macOS and Linux gates, and the shared ones by all
         three. The invariant it holds: no ffmpeg command pairs a copied video stream with a filter
         graph, because on macOS that command never finalizes. -->
    <Compile Include="../Shared/FfmpegMuxShapeTests.cs" Link="Shared/FfmpegMuxShapeTests.cs" />

    <!-- Issue #151: a test's failure path kills only the ffmpeg it started (OwnedFfmpeg), never a
         sweep over every ffmpeg on the machine - which would include a live recording's. Linked into
         all three suites so each platform's process handling is proven by its own gate. -->
    <Compile Include="../Shared/OwnedFfmpeg.cs" Link="Shared/OwnedFfmpeg.cs" />
    <Compile Include="../Shared/OwnedFfmpegTests.cs" Link="Shared/OwnedFfmpegTests.cs" />
    <Compile Include="../Shared/MicChainOrderTests.cs" Link="Shared/MicChainOrderTests.cs" />
  </ItemGroup>

</Project>
