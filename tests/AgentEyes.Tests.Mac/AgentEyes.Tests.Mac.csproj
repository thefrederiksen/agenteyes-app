<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tests for the macOS build of AgentEyes.Core (net8.0):
         dotnet test tests/AgentEyes.Tests.Mac -c Release
       Like AgentEyes.Tests.Linux, this project is deliberately NOT in AgentEyes.sln - the Windows
       gate (build + test the .sln) is unchanged, and these tests exercise macOS-only code
       (Platform/Mac). The referenced Core is forced to its macOS configuration so the suite is the
       same whichever machine runs it.

       EVERY TEST IN HERE IS A PURE-LOGIC TEST: argument lists, parsers and arithmetic. None of them
       captures a screen, opens a microphone or needs the Screen Recording permission, which is both
       why they run anywhere and the limit of what they prove. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <RootNamespace>AgentEyes.Tests.Mac</RootNamespace>
    <AssemblyName>AgentEyes.Tests.Mac</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #111: MacForeignFfmpegOptionTests also scans the Platform/Mac SOURCE as the backstop to
         its reflection sweep, so the repo root is stamped in at build time rather than guessed from
         the working directory - a scan that looked at nothing would pass while proving nothing. The
         Windows suite stamps the same key (see RepoSource). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Pin the engine to its macOS configuration, for the same reason the Linux suite pins itself
         to Linux: the suite must test the same engine whichever machine runs it. -->
    <ProjectReference Include="..\..\src\AgentEyes.Core\AgentEyes.Core.csproj"
                      AdditionalProperties="AgentEyesUnixPlatform=mac" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #122: pure argument-parsing tests shared by all three suites (Windows, Linux, macOS),
         compiled from ONE source file so every platform's build of the CLI passes the same ones. -->
    <Compile Include="../Shared/CliDispatcherTests.cs" Link="Shared/CliDispatcherTests.cs" />
    <!-- Issue #113: the platform-neutral capture watchdog, tested once for all three platforms. -->
    <Compile Include="../Shared/CaptureWatchdogTests.cs" Link="Shared/CaptureWatchdogTests.cs" />
    <Compile Include="../Shared/CaptureWatchdogWiringTests.cs" Link="Shared/CaptureWatchdogWiringTests.cs" />
    <Compile Include="../Shared/RecordingStopOrderTests.cs" Link="Shared/RecordingStopOrderTests.cs" />

    <Compile Include="../Shared/MuxLockTests.cs" Link="Shared/MuxLockTests.cs" />
    <Compile Include="../Shared/CaptureOwnershipTests.cs" Link="Shared/CaptureOwnershipTests.cs" />
    <Compile Include="../Shared/CaptureWriterReapTests.cs" Link="Shared/CaptureWriterReapTests.cs" />
    <Compile Include="../Shared/ProcessIdentityTests.cs" Link="Shared/ProcessIdentityTests.cs" />

    <!-- Issue #136: ONE guard, compiled into all three suites. FfmpegMuxShapeTests sweeps the
         argument builders in THIS build - which is the whole point of linking it rather than
         duplicating it: each suite's sweep sees its own platform's FfmpegArgs partial, so the macOS
         and Linux builders are covered by the macOS and Linux gates, and the shared ones by all
         three. The invariant it holds: no ffmpeg command pairs a copied video stream with a filter
         graph, because on macOS that command never finalizes. -->
    <Compile Include="../Shared/FfmpegMuxShapeTests.cs" Link="Shared/FfmpegMuxShapeTests.cs" />

    <!-- Issue #151: a test's failure path kills only the ffmpeg it started (OwnedFfmpeg), never a
         sweep over every ffmpeg on the machine - which would include a live recording's. Linked into
         all three suites so each platform's process handling is proven by its own gate. -->
    <Compile Include="../Shared/OwnedFfmpeg.cs" Link="Shared/OwnedFfmpeg.cs" />
    <Compile Include="../Shared/OwnedFfmpegTests.cs" Link="Shared/OwnedFfmpegTests.cs" />
    <!-- The opt-in for tests that launch a real ffmpeg (AGENTEYES_FFMPEG_TESTS=1), shared with the
         Windows suite so the repo has one convention. -->
    <Compile Include="../AgentEyes.Tests/FfmpegOptInAttributes.cs" Link="FfmpegOptInAttributes.cs" />
    <Compile Include="../Shared/MicChainOrderTests.cs" Link="Shared/MicChainOrderTests.cs" />
    <!-- Issue #196: every project that declares a version declares the same one (reads csproj files only). -->
    <Compile Include="../Shared/ReleaseVersionTests.cs" Link="Shared/ReleaseVersionTests.cs" />
    <!-- Issue #221: no user-facing text tells the reader to log in with a named desktop session (reads files only). -->
    <Compile Include="../Shared/SessionRemedyGuardTests.cs" Link="Shared/SessionRemedyGuardTests.cs" />
  </ItemGroup>

</Project>
