<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tests for the macOS build of AgentEyes.Core (net8.0):
         dotnet test tests/AgentEyes.Tests.Mac -c Release
       Like AgentEyes.Tests.Linux, this project is deliberately NOT in AgentEyes.sln - the Windows
       gate (build + test the .sln) is unchanged, and these tests exercise macOS-only code
       (Platform/Mac). The referenced Core is forced to its macOS configuration so the suite is the
       same whichever machine runs it.

       EVERY TEST IN HERE IS A PURE-LOGIC TEST: argument lists, parsers and arithmetic. None of them
       captures a screen, opens a microphone or needs the Screen Recording permission, which is both
       why they run anywhere and the limit of what they prove. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <RootNamespace>AgentEyes.Tests.Mac</RootNamespace>
    <AssemblyName>AgentEyes.Tests.Mac</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #111: MacForeignFfmpegOptionTests also scans the Platform/Mac SOURCE as the backstop to
         its reflection sweep, so the repo root is stamped in at build time rather than guessed from
         the working directory - a scan that looked at nothing would pass while proving nothing. The
         Windows suite stamps the same key (see RepoSource). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Pin the engine to its macOS configuration, for the same reason the Linux suite pins itself
         to Linux: the suite must test the same engine whichever machine runs it. -->
    <ProjectReference Include="..\..\src\AgentEyes.Core\AgentEyes.Core.csproj"
                      AdditionalProperties="AgentEyesUnixPlatform=mac" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #136: ONE guard, compiled into all three suites. FfmpegMuxShapeTests sweeps the
         argument builders in THIS build - which is the whole point of linking it rather than
         duplicating it: each suite's sweep sees its own platform's FfmpegArgs partial, so the macOS
         and Linux builders are covered by the macOS and Linux gates, and the shared ones by all
         three. The invariant it holds: no ffmpeg command pairs a copied video stream with a filter
         graph, because on macOS that command never finalizes. -->
    <Compile Include="..\Shared\FfmpegMuxShapeTests.cs" Link="Shared\FfmpegMuxShapeTests.cs" />
  </ItemGroup>

</Project>
