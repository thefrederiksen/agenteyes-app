<Project Sdk="Microsoft.NET.Sdk">

  <!-- Issue #102: the tests for the Linux build of AgentEyes.Core (net8.0). They run on Linux:
         dotnet test tests/AgentEyes.Tests.Linux -c Release
       This project is deliberately NOT in AgentEyes.sln - the Windows gate (build + test the .sln)
       is unchanged, and these tests exercise Linux-only code (Platform/Linux) and Unix file modes.
       CI runs them on ubuntu-latest (.github/workflows/ci.yml). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <RootNamespace>AgentEyes.Tests.Linux</RootNamespace>
    <AssemblyName>AgentEyes.Tests.Linux</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Issue #116 pass 4: the headless Avalonia platform, so the tray-popup close guard is driven through
         real windows (DesktopAppQuitTests.TrayPopupCloseGuardWindowTests). Same version as the app's Avalonia. -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin the engine to its LINUX configuration. On Linux this changes nothing; on a Mac, where
         the macOS configuration is the default, it is what keeps this suite testing Linux instead of
         failing to compile against Platform/Mac. -->
    <ProjectReference Include="..\..\src\AgentEyes.Core\AgentEyes.Core.csproj"
                      AdditionalProperties="AgentEyesUnixPlatform=linux" />
    <!-- The desktop app (issue #116: one project for all three platforms) picks its engine from the
         host. Pinned to linux here as well, so the app and this suite reference ONE build of the
         engine (the same global properties) instead of two that race to the same output folder. -->
    <ProjectReference Include="..\..\src\AgentEyes.DesktopApp\AgentEyes.DesktopApp.csproj"
                      AdditionalProperties="AgentEyesUnixPlatform=linux" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #122: pure argument-parsing tests shared by all three suites (Windows, Linux, macOS),
         compiled from ONE source file so every platform's build of the CLI passes the same ones. -->
    <Compile Include="..\Shared\CliDispatcherTests.cs" Link="Shared\CliDispatcherTests.cs" />
    <!-- Issue #116: the desktop app's quit-path tests, shared with AgentEyes.Tests.DesktopApp (Windows gate). -->
    <Compile Include="..\Shared\DesktopAppQuitTests.cs" Link="Shared\DesktopAppQuitTests.cs" />
    <!-- Issue #118: the macOS bundle's committed inputs (Info.plist, AgentEyes.icns) and the app name. -->
    <Compile Include="..\Shared\MacBundleTests.cs" Link="Shared\MacBundleTests.cs" />

    <Compile Include="..\Shared\MuxLockTests.cs" Link="Shared\MuxLockTests.cs" />

    <!-- Issue #136: ONE guard, compiled into all three suites. FfmpegMuxShapeTests sweeps the
         argument builders in THIS build - which is the whole point of linking it rather than
         duplicating it: each suite's sweep sees its own platform's FfmpegArgs partial, so the macOS
         and Linux builders are covered by the macOS and Linux gates, and the shared ones by all
         three. The invariant it holds: no ffmpeg command pairs a copied video stream with a filter
         graph, because on macOS that command never finalizes. -->
    <Compile Include="../Shared/FfmpegMuxShapeTests.cs" Link="Shared/FfmpegMuxShapeTests.cs" />

    <!-- Issue #151: a test's failure path kills only the ffmpeg it started (OwnedFfmpeg), never a
         sweep over every ffmpeg on the machine - which would include a live recording's. Linked into
         all three suites so each platform's process handling is proven by its own gate. -->
    <Compile Include="../Shared/OwnedFfmpeg.cs" Link="Shared/OwnedFfmpeg.cs" />
    <Compile Include="../Shared/OwnedFfmpegTests.cs" Link="Shared/OwnedFfmpegTests.cs" />
    <!-- The opt-in for tests that launch a real ffmpeg (AGENTEYES_FFMPEG_TESTS=1), shared with the
         Windows suite so the repo has one convention. -->
    <Compile Include="../AgentEyes.Tests/FfmpegOptInAttributes.cs" Link="FfmpegOptInAttributes.cs" />
    <Compile Include="../Shared/MicChainOrderTests.cs" Link="Shared/MicChainOrderTests.cs" />
  </ItemGroup>

</Project>
