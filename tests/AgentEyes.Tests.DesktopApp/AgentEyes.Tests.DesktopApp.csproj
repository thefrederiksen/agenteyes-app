<Project Sdk="Microsoft.NET.Sdk">

  <!-- Issue #116: tests of the desktop app (src/AgentEyes.DesktopApp) that run on the WINDOWS gate.
         dotnet test tests/AgentEyes.Tests.DesktopApp -c Release
       It is in AgentEyes.sln, so "dotnet test AgentEyes.sln -c Release" and the CI windows job run it.
       Until this project, no desktop-app test ran on Windows at all: the app's tests live in
       AgentEyes.Tests.Linux, which links the Linux engine and is deliberately outside the solution.
       The target framework follows the app's: the Windows build of the app is
       net8.0-windows10.0.19041.0 (it links the Windows engine), so a test project that references it
       must carry the same TFM on Windows; elsewhere both are net8.0.
       It does not start the app, open a window or record anything - those are runtime checks
       (scripts/windows/tray-quit-repro.ps1). -->
  <PropertyGroup>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net8.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>x64;arm64</Platforms>
    <RootNamespace>AgentEyes.Tests.DesktopApp</RootNamespace>
    <AssemblyName>AgentEyes.Tests.DesktopApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Issue #116 pass 4: the headless Avalonia platform, so the tray-popup close guard is driven through
         real windows (DesktopAppQuitTests.TrayPopupCloseGuardWindowTests). Same version as the app's Avalonia. -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentEyes.DesktopApp\AgentEyes.DesktopApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with AgentEyes.Tests.Linux, so Linux CI runs the same tests. -->
    <Compile Include="..\Shared\DesktopAppQuitTests.cs" Link="Shared\DesktopAppQuitTests.cs" />
    <!-- Issue #161 pass 2: a redirected desktop app refuses to start (it always drives the REAL service on 7882). -->
    <Compile Include="..\Shared\DesktopAppRedirectTests.cs" Link="Shared\DesktopAppRedirectTests.cs" />
  </ItemGroup>

</Project>
