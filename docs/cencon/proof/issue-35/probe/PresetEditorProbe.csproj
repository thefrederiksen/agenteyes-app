<Project Sdk="Microsoft.NET.Sdk">

  <!-- Issue #35 measurement harness. NOT part of AgentEyes.sln - it is proof tooling, built and run
       on demand so QA (or anyone) can reproduce the numbers in layout-measurement.txt:

         dotnet run -c Release [project] docs\cencon\proof\issue-35\probe\PresetEditorProbe.csproj

       It ProjectReferences AgentEyes.App so it always measures a FRESH build of the real dialog
       rather than whatever happens to be sitting in a bin directory. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>AgentEyes.Proof</RootNamespace>
    <AssemblyName>PresetEditorProbe</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\AgentEyes.App\AgentEyes.App.csproj" />
  </ItemGroup>

</Project>
