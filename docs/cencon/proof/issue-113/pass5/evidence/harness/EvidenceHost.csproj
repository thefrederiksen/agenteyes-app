<Project Sdk="Microsoft.NET.Sdk">
  <!-- Issue #113 pass 5 evidence host. NOT part of the product. Named AgentEyes.Tests only so the
       product's existing InternalsVisibleTo lets it construct RecordingService and
       HeadlessControlServer. CoreProj selects which tree's AgentEyes.Core it runs (the branch head,
       or the pre-#156 control). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <AssemblyName>AgentEyes.Tests</AssemblyName>
    <RootNamespace>EvidenceHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CoreProj)" />
  </ItemGroup>
</Project>
