<Project Sdk="Microsoft.NET.Sdk">
  <!-- QA #156 pass 4 scratch harness. AssemblyName matches an InternalsVisibleTo entry of
       AgentEyes.Core (AgentEyes.Tests.Linux) so the internal callers are reachable without reflection.
       Product code is referenced as the BUILT dll, never compiled in here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AgentEyes.Tests.Linux</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Reference Include="agenteyes"><HintPath>$(AeDll)</HintPath></Reference>
  </ItemGroup>
</Project>
